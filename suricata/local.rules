# LOCAL custom Suricata rules for the SOC lab
# sid 100200 — deterministic port-scan detection (stock ET rules miss quiet SYN scans)
alert tcp any any -> any any (msg:"LOCAL Portscan detected - 20+ SYN from single source in 10s"; flags:S; flow:to_server; detection_filter:track by_src, count 20, seconds 10; classtype:attempted-recon; sid:100200; rev:1;)
