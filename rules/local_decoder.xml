<!-- Custom decoder for YARA active-response output.
     Parses lines written by active-response/yara-scan.sh:
       wazuh-yara: INFO - Scan result: <rule_name> <file_path>
     Install to /var/ossec/etc/decoders/local_decoder.xml on the manager. -->
<decoder name="yara_decoder">
  <prematch>wazuh-yara:</prematch>
</decoder>

<decoder name="yara_decoder1">
  <parent>yara_decoder</parent>
  <regex>wazuh-yara: (\S+) - Scan result: (\S+) (\S+)</regex>
  <order>log_type, yara_rule, yara_scanned_file</order>
</decoder>
